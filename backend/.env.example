NODE_ENV=development
PORT=5000

# MongoDB - Replace with your MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017/moveflow_tn

# JWT - CHANGE THESE IN PRODUCTION
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Email (Nodemailer) - Optional in development; app works without it
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="MoveFlow TN <noreply@moveflow.tn>"

# File Upload
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Platform Commission (%)
PLATFORM_COMMISSION_RATE=0.12

